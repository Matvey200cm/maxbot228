# Max Bot
MAX_API_TOKEN=your_max_bot_token_here

# Max Bot API URL (для локальной разработки или кастомного прокси)
MAX_API_URL=https://api.max.ru

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://maxbot:maxbot_password@localhost:5432/maxbot_db

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Reminders check interval in minutes
REMINDER_CHECK_INTERVAL=5
