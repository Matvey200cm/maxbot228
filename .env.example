# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
BOT_ADMIN_ID=0

# HTTP-прокси для доступа к Telegram (оставьте пустым для прямого подключения)
# PROXY_URL=http://127.0.0.1:10809

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://maxbot:maxbot_password@localhost:5432/maxbot_db

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Reminders check interval in minutes
REMINDER_CHECK_INTERVAL=5
